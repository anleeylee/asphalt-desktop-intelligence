{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TakeoffRecord",
  "description": "S02 required takeoff record contract.",
  "type": "object",
  "required": ["area_id", "sheet", "surface", "quantity", "unit", "method", "confidence", "state"],
  "properties": {
    "area_id": {"type": "string"},
    "sheet": {"type": "string"},
    "surface": {"type": "string"},
    "quantity": {"type": "number"},
    "unit": {"type": "string"},
    "thickness": {"type": ["number", "null"]},
    "thickness_unit": {"type": ["string", "null"]},
    "source_file": {"type": ["string", "null"]},
    "source_page": {"type": ["integer", "null"]},
    "method": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "state": {"enum": ["EXTRACTED", "NORMALIZED", "VALIDATED", "VERIFIED"]},
    "calc": {"type": ["object", "null"]},
    "flags": {"type": "array", "items": {"type": "string"}}
  }
}
